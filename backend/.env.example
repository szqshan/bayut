# Application
APP_NAME=Bayut Property Platform
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://bayut:bayut123@localhost:5432/bayut_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Bayut API Configuration (RapidAPI)
BAYUT_API_KEY=your_rapidapi_key_here
BAYUT_API_HOST=bayut-api1.p.rapidapi.com
BAYUT_BASE_URL=https://bayut-api1.p.rapidapi.com
BAYUT_RATE_LIMIT=10

# JWT Configuration (for future user authentication)
JWT_SECRET_KEY=your_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery Configuration (for future background tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Notification Services (for future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_password

# AI Services (for future use)
OPENAI_API_KEY=your_openai_key_here

# Monitoring (for future use)
SENTRY_DSN=your_sentry_dsn_here
